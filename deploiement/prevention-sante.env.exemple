# =====================================================================
#  Configuration et secrets — MODÈLE
#
#  À copier en /etc/prevention-sante.env puis :
#      chown root:prevention /etc/prevention-sante.env
#      chmod 640 /etc/prevention-sante.env
#
#  CE FICHIER NE DOIT JAMAIS ÊTRE VERSIONNÉ, ni figurer dans une
#  sauvegarde à côté de la base : une sauvegarde contenant les données ET
#  leur clé de chiffrement n'est pas chiffrée, elle est seulement
#  compliquée.
# =====================================================================

# --- base de données -------------------------------------------------
# L'utilisateur doit être « prevention_appli », créé par rls.sql, et NON
# le propriétaire des tables : le propriétaire contourne les politiques de
# sécurité au niveau des lignes. C'est le premier point qu'un audit
# vérifiera.
DATABASE_URL=postgres://prevention_appli:MOT_DE_PASSE@localhost:5432/prevention

# --- chiffrement des colonnes sensibles ------------------------------
# 64 caractères hexadécimaux. À générer une seule fois avec :
#     npm run cle
#
# SI CETTE CLÉ EST PERDUE, LES NUMÉROS DE SÉCURITÉ SOCIALE DEVIENNENT
# DÉFINITIVEMENT ILLISIBLES. Ni nous, ni AZNETWORK, ni personne ne peut
# les récupérer. Conservez-la dans un coffre à secrets, et une copie de
# recouvrement sous scellé chez une deuxième personne.
CLE_CHIFFREMENT=

# --- écoute ----------------------------------------------------------
PORT=3000
# Adresse publique, utilisée dans les liens envoyés par courriel.
URL_PUBLIQUE=https://prevention.example.fr

# --- envoi de courriels ----------------------------------------------
# Sans ces variables, aucun courriel n'est envoyé et le lien de
# réinitialisation s'affiche à l'écran — acceptable en recette, jamais en
# production.
COURRIEL_SMTP=smtp.example.fr:587
COURRIEL_UTILISATEUR=
COURRIEL_MOTDEPASSE=
COURRIEL_EXPEDITEUR=ne-pas-repondre@dev-sante.fr

# --- journaux --------------------------------------------------------
# erreur | avert | info | debug
TRACE_NIVEAU=info
